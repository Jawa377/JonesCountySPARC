# Copy to .env for local development. Never commit .env.
#
# JAWSDB_URL — the shared MySQL server connection string your instructor gives
# you when your database is provisioned. Same shape it had on Heroku's JawsDB
# add-on: mysql://username:password@host:port/database_name
JAWSDB_URL=mysql://username:password@host:3306/database_name

# FLASK_SECRET_KEY — any long random string. The app refuses to start without
# it. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-locally
