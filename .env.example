# Copy to .env for local development. Never commit .env.
#
# DATABASE_ENGINE — "sqlite" (default, local file database/sparc.db) or
# "mysql" (uses JAWSDB_URL below). Set to mysql on Dokku.
DATABASE_ENGINE=sqlite

# JAWSDB_URL — only used when DATABASE_ENGINE=mysql. The shared MySQL server connection string your instructor gives
# you when your database is provisioned. Same shape it had on Heroku's JawsDB
# add-on: mysql://username:password@host:port/database_name
JAWSDB_URL=mysql://username:password@host:3306/database_name

# FLASK_SECRET_KEY — any long random string. The app refuses to start without
# it. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-locally

# SQLITE_PATH — optional. Where the SQLite database lives when
# DATABASE_ENGINE=sqlite. Defaults to database/sparc.db.
# SQLITE_PATH=database/sparc.db
